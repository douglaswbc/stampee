# App
VITE_APP_URL=https://your-app-url.com

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase functions (vercel dev / Vercel)
# Keep these server-only; never add the VITE_ prefix to service secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public canonical origin used by callbacks and public-site URLs.
# Usually keep this aligned with VITE_APP_URL.
APP_ORIGIN=https://your-app-url.com

# Zernio integration secrets (server-only)
# Use a stable random value with at least 32 characters; changing it requires re-encrypting stored keys.
ZERNIO_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Used to authorize /api/zernio-worker; use at least 16 random characters.
COMMUNICATIONS_CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# Optional build-time override for scripts/generate-sitemap.mjs
# SITE_ORIGIN=https://your-app-url.com

# Optional: Demo workspace (use only in dev; known credentials)
# VITE_ENABLE_DEMO_WORKSPACE=true

# Optional: Support email shown in app
# VITE_SUPPORT_EMAIL=support@example.com
